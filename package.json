{
  "name": "vocab-tracker",
  "private": true,
  "version": "1.10.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite",
    "dev:api": "bun server/dev.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:codex": "bun test tests/codex",
    "test:all": "bun run test && bun run test:codex",
    "codex:install": "bun scripts/install-codex-skill.ts",
    "verify:api": "bun scripts/verify-learning-api.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-virtual": "^3.13.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/bun": "1.4.2",
    "@types/node": "^25.0.3",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.9.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.6",
    "workbox-window": "^7.4.0"
  }
}
