{
  "name": "vocab-tracker",
  "private": true,
  "version": "1.10.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite",
    "dev:api": "bun server/dev.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:codex": "bun test tests/codex",
    "test:all": "bun run test && bun run test:codex",
    "codex:install": "bun scripts/install-codex-skill.ts",
    "verify:api": "bun scripts/verify-learning-api.ts",
    "test:watch": "vitest",
    "typecheck:compat": "tsc6 --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.1",
    "@tanstack/react-virtual": "3.14.13",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.5",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "workbox-window": "7.4.1"
  },
  "engines": {
    "node": "24.x"
  }
}
